# Django Core Security Settings
# Unique cryptographic secret key for signing cookies and tokens. Do not share.
SECRET_KEY=your-super-secret-key-change-this-in-production

# Enable or disable debug mode (True for development, False for production)
DEBUG=False

# Comma-separated list of hostnames/domain names this site can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for unsafe requests (e.g. POST)
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SQLite Database path relative to project root or absolute
DATABASE_PATH=db.sqlite3

# OCR Configuration
# Path to the Tesseract executable (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe on Windows or /usr/bin/tesseract on Linux)
TESSERACT_CMD=

# Tesseract languages to use for OCR scanning separated by plus sign (e.g., eng or eng+hin)
TESSERACT_LANGS=eng

# Minimum average confidence score (0 to 100) to consider OCR output reliable
OCR_MIN_CONFIDENCE=45.0

# Upload Limits & Media Paths
# Optional custom directory path for media uploads (leave blank to default to <BASE_DIR>/media)
MEDIA_ROOT=

# Optional custom directory path for static files collection (leave blank to default to <BASE_DIR>/staticfiles)
STATIC_ROOT=

# Maximum allowed upload file size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Comma-separated list of allowed image extensions
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Security & Cookie Flags (Enforced when DEBUG=False)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# Email Configuration (Optional - only required if email delivery service is configured)
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=webmaster@localhost

# Initial Superuser Seeding (Used only by management command seed_demo)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=ChangeMeAdmin123!

# Demo User Credentials (Used only by management command seed_demo)
DEMO_USER_PASSWORD=ChangeMeDemo123!
